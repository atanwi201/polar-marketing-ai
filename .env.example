# ============================================================================
# Polar Marketing: copy this file to .env and fill in what you have.
#   cp .env.example .env
# Leave any key empty to skip that provider (one key is enough to start).
# `npm run push-env` copies the AI section to the server's .env and restarts it,
# so you only ever edit this one file. Keys saved in the dashboard win over .env.
# ============================================================================

# ---- AI text providers (tried in order, the next one answers when one is limited) ----
# Free keys:  Groq console.groq.com/keys · Google aistudio.google.com/apikey · Mistral console.mistral.ai/api-keys
#             OpenRouter openrouter.ai/keys · SiliconFlow cloud.siliconflow.com · DeepSeek platform.deepseek.com
#             TokenHarbor tokenharbor.ai (OpenAI-compatible gateway, free models)
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
TOKENHARBOR_API_KEY=
# Paid, only used when you pick it in the dashboard (Auto never spends money):
OPENAI_API_KEY=
# Puter: no developer key. Click "Sign in with Puter" in the dashboard (local), or paste the session token here.
PUTER_AUTH_TOKEN=

# Order tried first (the rest follow). Providers: groq, google, mistral, siliconflow, deepseek, alibaba, puter, tokenharbor, openai, openrouter
AI_PROVIDERS=groq,google,mistral
# Optional models per provider (comma list, first is tried first). Empty = automatic. Easier: pick them in the dashboard.
GROQ_MODELS=
GEMINI_MODELS=
MISTRAL_MODELS=
SILICONFLOW_MODELS=
DEEPSEEK_MODELS=
ALIBABA_MODELS=
OPENAI_MODELS=
PUTER_MODELS=
TOKENHARBOR_MODELS=
# Alternative endpoints, only if needed:
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1

# ---- Voice: speech to text and text to speech ----
# NagaAI is optional. Without it the app uses Puter (your own allowance) and the browser can also
# do the listening itself, so the dictation of expenses works either way.
NAGAAI_API_KEY=
# NAGAAI_BASE_URL=https://api.naga.ac/v1
# NAGAAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# NAGAAI_TTS_MODEL=gpt-4o-mini-tts
# NAGAAI_TTS_VOICE=alloy

# ---- Images and photos ----
# "free" (default, Pollinations, no key), "openrouter" (paid), "google" or "puter". The studio choice wins over this line.
# IMAGE_PROVIDER=free
POLLINATIONS_KEY=
PEXELS_API_KEY=
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# GOOGLE_IMAGE_MODEL=gemini-nano-banana-2.1
# IMAGE_MODEL=

# ---- Server ----
# PORT=8787
# PUBLIC_URL=https://your-domain.com    # public https address: site canonical URLs, webhooks, link previews
# ADMIN_PASSWORD=                       # fixes the admin password (otherwise you create it on the home page)
# ADMIN_TOKEN=change-me                 # lets scripts call /api/studio with an x-admin-token header
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg  # video ads need ffmpeg
# OPENROUTER_TIMEOUT_MS=120000          # give up on a slow model after this and try the next
# SITE_MODEL_TIMEOUT_MS=540000          # how long a model may take to design or translate a website page

# ---- Google Business Profile (connect a client's profile; see docs/gbp-access-request.md) ----
# Everything stays empty until Basic API Access is approved and the OAuth client exists. Without these,
# the portal shows the manual kit only and the connect route answers "not configured".
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/gbp/callback   # exactly as registered in the Cloud console
# TOKEN_ENC_KEY=                  # 32+ random chars: openssl rand -base64 48. Encrypts stored Google tokens at rest.
#                                 # Changing it does not lose data, but every client has to reconnect.
# GBP_API_ENABLED=false           # off: the portal shows the manual kit. On: the API screens (G5/G10).

# ---- Direct publishing (each client's own tokens are entered in the studio) ----
# X_API_KEY=
# X_API_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_PRIVACY=public                # public | unlisted | private
# META_GRAPH_VERSION=v25.0

# ---- Apple Wallet (loyalty cards) ----
# Without these, customers get the web card only. All values stay empty until you have them.
# 1. Join the Apple Developer Program (developer.apple.com, 99 USD/year).
# 2. Certificates, Identifiers & Profiles > Identifiers > add a "Pass Type ID" (e.g. pass.com.yourbrand.loyalty).
# 3. Open that Pass Type ID > Create Certificate, upload a CSR made in Keychain Access, download the .cer.
# 4. Double-click the .cer, then in Keychain export the certificate+key as .p12 and split it:
#      openssl pkcs12 -in pass.p12 -clcerts -nokeys -out pass-cert.pem
#      openssl pkcs12 -in pass.p12 -nocerts -out pass-key.pem
# 5. Download "Apple WWDR G4" from apple.com/certificateauthority and convert: openssl x509 -inform der -in AppleWWDRCAG4.cer -out wwdr.pem
# 6. Your Team ID is under Membership details. PUBLIC_URL above must be https (Wallet only talks to https).
# Use the *_PATH of a file on the server, or the *_BASE64 of the file contents (base64 -i file.pem | tr -d '\n') instead.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PATH=
# APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_PATH=
# APPLE_PASS_KEY_BASE64=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_PATH=
# APPLE_WWDR_BASE64=
# APNS_HOST=api.push.apple.com          # live pushes; use api.sandbox.push.apple.com only for development builds

# ---- Google Wallet (loyalty cards, free) ----
# Customers on Android get "Add to Google Wallet". Without these only the Apple/web card shows.
# 1. Google Pay & Wallet Console (pay.google.com/business/console): create an issuer account, copy the Issuer ID.
# 2. Google Cloud Console: create a project, enable "Google Wallet API", create a service account and a JSON key.
# 3. In the Wallet Console > Users, invite the service account's email as a Developer.
# 4. Paste the whole JSON key on one line (or base64 of it) below; PUBLIC_URL above must be https.
# New issuers start in demo mode (only test users you add in the console can save cards); request publishing access in the console to go public.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=

# Booking confirmation emails (transactional only, to the customer who booked). Leave empty to disable sending.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=

# ---- Legal identity (REQUIRED before launch: LSSI-CE art. 10 and RGPD art. 13) ----
# Shown on /privacy, /legal and in booking emails. Set NODE_ENV=production on the server (the draft warning and the dev contact fallback only apply outside production). Leave empty only in development: pages then show a visible
# [PENDIENTE] warning. Use a business mailbox, not a personal one. Do not invent data: fill in your own.
LEGAL_NAME=
LEGAL_NIF=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
# Booking emails: use a sending domain verified in Resend (SPF/DKIM/DMARC). The Resend sandbox sender only reaches the account owner.
