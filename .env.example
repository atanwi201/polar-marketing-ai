# Free key at https://openrouter.ai/keys. Only free models (":free", price 0) are ever called.
OPENROUTER_API_KEY=

# Extra text providers, used as fallbacks when one hits its limit (any one key is enough).
# Free keys: https://console.groq.com/keys and https://console.mistral.ai/api-keys
GROQ_API_KEY=
MISTRAL_API_KEY=
# GEMINI_API_KEY=       # Google AI Studio, free tier: aistudio.google.com/apikey
# DEEPSEEK_API_KEY=
# SILICONFLOW_API_KEY=
# DASHSCOPE_API_KEY=    # Alibaba Cloud Model Studio (Qwen)
# PUTER_AUTH_TOKEN=    # Puter.js (puter.ai.chat); set the model in the dashboard
# OPENAI_API_KEY=
# AI_PROVIDERS=groq,google,mistral   # order tried first; the rest follow   # order tried; the next one answers when a provider is rate-limited
# GROQ_MODELS=llama-3.3-70b-versatile    # optional comma list to override the built-in models
# MISTRAL_MODELS=mistral-small-latest

# Optional
# PORT=8787
# PUBLIC_URL=https://your-domain.com   # public https address of this server: site canonical URLs, webhook links,
#                                      # Facebook/X link previews (/p/...) and direct Instagram photo posts
# ADMIN_PASSWORD=                      # optional: fixes the admin password (otherwise you create it on the home page)
# ADMIN_TOKEN=change-me                # optional: lets scripts call /api/studio with an x-admin-token header
# Images: "free" (default, Pollinations, no key), "openrouter" (paid, uses OPENROUTER_API_KEY) or "google".
# Easiest to switch in the studio: Content Studio > Images. The studio choice wins over this line.
# IMAGE_PROVIDER=free
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b   # any model from openrouter.ai/models?output_modalities=image
# GOOGLE_API_KEY=                      # Google AI Studio key (aistudio.google.com/apikey, billing on)
# GOOGLE_IMAGE_MODEL=gemini-nano-banana-2.1
# IMAGE_MODEL=                         # free-service model; by default the first one it offers
# POLLINATIONS_KEY=                    # optional key from enter.pollinations.ai: without it the free tier gives
#                                      # one image every 45 s, so a 3-scene video takes about 3 minutes
# OPENROUTER_TIMEOUT_MS=120000         # give up on a slow free model after this and try the next one

# Video ads need ffmpeg on the server (macOS: brew install ffmpeg). Voice-over uses the macOS system voices.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Direct publishing. Each client's own tokens are entered in the studio (client > Social accounts).
# X: your app's keys from developer.x.com (app permissions: read and write)
# X_API_KEY=
# X_API_SECRET=
# YouTube Shorts: an OAuth client from Google Cloud with the YouTube Data API v3 enabled
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_PRIVACY=public               # public | unlisted | private (unverified Google apps upload as private)
# META_GRAPH_VERSION=v25.0
# PEXELS_API_KEY=                      # optional, free at pexels.com/api: nicer stock photos for client websites (default: Openverse, no key)
# SITE_MODEL_TIMEOUT_MS=540000          # how long a free model may take to design or translate a website page
