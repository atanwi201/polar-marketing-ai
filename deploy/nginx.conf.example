# /etc/nginx/sites-available/isla-autopilot  (example; replace server_name and certificate paths)
# Rate-limit zones belong in the http{} context (e.g. /etc/nginx/conf.d/isla-zones.conf):
limit_req_zone $binary_remote_addr zone=isla_general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=isla_auth:10m rate=5r/m;     # signup / login
limit_req_zone $binary_remote_addr zone=isla_upload:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=isla_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name marketing.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name marketing.example.com;

    ssl_certificate     /etc/letsencrypt/live/marketing.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/marketing.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Request size limits: keep in line with the app (JSON bodies are small; uploads are photos, clips and site zips).
    client_max_body_size 60m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 60s;
    limit_conn isla_conn 30;
    limit_req_status 429;

    location = /api/signup      { limit_req zone=isla_auth burst=5 nodelay;   client_max_body_size 8m;  include snippets/isla-proxy.conf; }
    location = /api/client-login { limit_req zone=isla_auth burst=5 nodelay;  client_max_body_size 16k; include snippets/isla-proxy.conf; }
    location = /api/login       { limit_req zone=isla_auth burst=5 nodelay;   client_max_body_size 16k; include snippets/isla-proxy.conf; }
    location ~ ^/api/.*/(upload|zip)$ { limit_req zone=isla_upload burst=10; client_max_body_size 60m; include snippets/isla-proxy.conf; }
    location /api/ { limit_req zone=isla_general burst=30 nodelay; client_max_body_size 2m; include snippets/isla-proxy.conf; }
    location /     { limit_req zone=isla_general burst=60 nodelay; include snippets/isla-proxy.conf; }
}

# /etc/nginx/snippets/isla-proxy.conf  (nginx cannot nest includes of this kind inline; save this as its own file):
#   proxy_pass http://127.0.0.1:8787;
