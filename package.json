{
  "name": "polar-marketing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build && node scripts/to-artifact.mjs",
    "start": "npm run build && node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh",
    "push-env": "bash scripts/push-env.sh"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.6.4",
    "@napi-rs/canvas": "^1.0.11",
    "fflate": "^0.8.3",
    "passkit-generator": "^3.7.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
